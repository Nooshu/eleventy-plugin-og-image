{
  "name": "eleventy-plugin-og-image",
  "version": "4.4.0",
  "description": "A plugin to create Open Graph Images from JSX for Eleventy.",
  "author": {
    "name": "Kilian Finger",
    "email": "npm@kilianfinger.com",
    "url": "https://www.kilianfinger.com/"
  },
  "license": "MIT",
  "keywords": [
    "11ty",
    "eleventy",
    "eleventy-plugin",
    "og:image"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/KiwiKilian/eleventy-plugin-og-image.git"
  },
  "bugs": {
    "url": "https://github.com/KiwiKilian/eleventy-plugin-og-image/issues"
  },
  "homepage": "https://github.com/KiwiKilian/eleventy-plugin-og-image#readme",
  "main": "./.eleventy.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./.eleventy.js"
    },
    "./package.json": "./package.json",
    "./og-image": "./src/OgImage.js",
    "./utils": "./src/utils/index.js"
  },
  "types": "./index.d.ts",
  "files": [
    ".eleventy.js",
    "index.d.ts",
    "src"
  ],
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "postinstall": "node scripts/patch-bundled-undici.js",
    "semantic-release": "semantic-release",
    "test": "ava test/**/*.test.js",
    "test:coverage": "c8 --100 --all --include=.eleventy.js --include=src/**/*.js --include=scripts/**/*.js ava test/**/*.test.js",
    "lint": "eslint .",
    "prettier": "prettier --write .",
    "example": "npx @11ty/eleventy --config=example/.eleventy.js --input=example --output=example/_site",
    "example:start": "npm run example -- --serve",
    "example:build": "npm run example",
    "example:clean": "rimraf ./example/_site"
  },
  "engines": {
    "node": ">=18"
  },
  "11ty": {
    "compatibility": ">=3.0.0"
  },
  "peerDependencies": {
    "@11ty/eleventy": ">=3.0.0"
  },
  "dependencies": {
    "@11ty/eleventy-utils": "^3.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "satori": "^0.63.2",
    "satori-html": "^0.3.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.7",
    "@fontsource/inter": "5.3.0",
    "@kiwikilian/eslint-config": "1.1.0",
    "@kiwikilian/prettier-config": "1.0.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "ava": "8.0.1",
    "c8": "^11.0.0",
    "eslint": "8.57.1",
    "prettier": "3.9.10",
    "prettier-plugin-jinja-template": "2.2.0",
    "prettier-plugin-jsdoc": "1.8.1",
    "semantic-release": "25.0.9",
    "twemoji": "14.0.2"
  },
  "overrides": {
    "sharp": "$sharp",
    "handlebars": "4.7.10",
    "liquidjs": "10.30.0",
    "markdown-it": "14.3.3",
    "linkify-it": "5.0.2",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "brace-expansion@5": "5.0.12",
    "minimatch@9": "9.0.9",
    "js-yaml@3": "3.15.2",
    "js-yaml@4": "4.3.2",
    "@fastify/busboy": "3.2.2",
    "postcss-selector-parser": "7.1.6",
    "ip-address": "10.7.1",
    "undici": "6.29.1",
    "ws": "8.22.0",
    "tar": "7.5.22",
    "ajv": "6.14.0",
    "fflate": "0.7.5",
    "http-cache-semantics": "4.3.0",
    "npm": {
      "brace-expansion": "5.0.12",
      "postcss-selector-parser": "7.1.6",
      "ip-address": "10.7.1",
      "undici": "6.29.1",
      "http-cache-semantics": "4.3.0",
      "node-gyp": {
        "undici": "6.29.1"
      }
    },
    "sprintf-js": "file:vendor/sprintf-js"
  }
}
