{
  "all": true,
  "check-coverage": true,
  "lines": 100,
  "statements": 100,
  "functions": 100,
  "branches": 100,
  "include": [".eleventy.js", "src/**/*.js", "scripts/**/*.js"],
  "exclude": [
    "coverage/**",
    "example/**",
    "test/**",
    "vendor/**",
    "node_modules/**",
    ".prettierrc.js"
  ],
  "reporter": ["text", "text-summary"]
}
